    "imputation": false,
    "label_clipping": false,
    "tau_absolute_tolerance": 1e-08,
    "xHI_obs_absolute_tolerance": 1e-10
  },
  "split": "group on complete physical parameter tuple, all IC together; 80/20 train/development-validation",
  "normalization_and_PCA": "train only",
  "seed_target": "fixed_ic",
  "failure_records": "retain parameters, reason and stratum; no implicit -infinity prior",
