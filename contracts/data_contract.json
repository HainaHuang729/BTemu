{
  "label": "volume-mean global_xHI, full 32-node trajectory",
  "ground_truth": "contract-matched local BT native only",
  "source_access": "explicit development allowlist, immutable external paths; no sealed-label reads",
  "required_fields": [
    "sample_id",
    "physical_parameters",
    "fixed_parameters",
    "ic_seed",
    "redshifts",
    "global_xHI",
    "exact_tau",
